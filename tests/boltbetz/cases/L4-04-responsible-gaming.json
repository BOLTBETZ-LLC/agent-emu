{
 "id": "L4-04-responsible-gaming",
 "lane": "L4",
 "timeout_s": 90,
 "preconditions": {
  "signed_in": true,
  "kyc": true,
  "venue_card": false
 },
 "steps": [
  {
   "call": "deep_link",
   "uri": "boltbetz-staging://e2e-session/hooks?on=1"
  },
  {
   "sleep_ms": 800
  },
  {
   "call": "deep_link",
   "uri": "boltbetz-staging://e2e-session/route/MainFlow/Tabs/Home"
  },
  {
   "sleep_ms": 800
  },
  {
   "tap_id": "tab-home",
   "optional": true,
   "wait_s": 2
  },
  {
   "wait_id": "home-screen",
   "wait_s": 15
  },
  {
   "tap_id": "tab-settings"
  },
  {
   "wait_id": "settings-screen"
  },
  {
   "call": "swipe",
   "x1": 660,
   "y1": 2300,
   "x2": 660,
   "y2": 700,
   "device_px": true,
   "screenshot": false
  },
  {
   "sleep_ms": 600
  },
  {
   "tap_id": "settings-responsible-gaming"
  },
  {
   "wait_id": "responsible-gaming-screen"
  },
  {
   "check": {
    "ui": "responsible-gaming-deposit-value"
   }
  },
  {
   "check": {
    "ui": "responsible-gaming-duration-value"
   }
  },
  {
   "check": {
    "ui": "responsible-gaming-help-text"
   }
  },
  {
   "check": {
    "screenshot": "limits"
   }
  },
  {
   "call": "deep_link",
   "uri": "boltbetz-staging://e2e-session/route/MainFlow/Tabs/Home"
  },
  {
   "sleep_ms": 800
  },
  {
   "tap_id": "tab-home",
   "optional": true,
   "wait_s": 2
  },
  {
   "wait_id": "home-screen",
   "wait_s": 15
  }
 ],
 "checks": [
  {
   "ui": "home-screen"
  },
  {
   "no_crash": "com.boltbetz.staging"
  },
  {
   "logs_lack": "FATAL EXCEPTION|ReactNativeJS.*(Unhandled|TypeError|Invariant Violation)",
   "filter": "com.boltbetz.staging"
  }
 ],
 "cleanup": [
  {
   "call": "deep_link",
   "uri": "boltbetz-staging://e2e-session/fault?clear=1"
  },
  {
   "call": "deep_link",
   "uri": "boltbetz-staging://e2e-session/route/MainFlow/Tabs/Home"
  }
 ],
 "note": "Responsible Gaming limits screen renders. Never changes a limit (limits cannot be lowered once set)."
}
