{
 "id": "L2-01-wallet-renders",
 "lane": "L2",
 "timeout_s": 90,
 "preconditions": {
  "signed_in": true,
  "kyc": true,
  "venue_card": false
 },
 "steps": [
  {
   "call": "deep_link",
   "uri": "boltbetz-staging://e2e-session/hooks?on=1"
  },
  {
   "sleep_ms": 800
  },
  {
   "call": "deep_link",
   "uri": "boltbetz-staging://e2e-session/route/MainFlow/Tabs/Home"
  },
  {
   "sleep_ms": 800
  },
  {
   "tap_id": "tab-home",
   "optional": true,
   "wait_s": 2
  },
  {
   "wait_id": "home-screen",
   "wait_s": 15
  },
  {
   "call": "deep_link",
   "uri": "boltbetz-staging://e2e-session/route/MainFlow/Tabs/Wallet/WalletMain"
  },
  {
   "wait_id": "wallet-main-screen"
  },
  {
   "check": {
    "ui": "wallet-balance-hero"
   }
  },
  {
   "check": {
    "ui_any": [
     "wallet-balance-amount",
     "wallet-balance-value",
     "wallet-balance-unknown"
    ]
   }
  },
  {
   "check": {
    "ui": "wallet-action-deposit"
   }
  },
  {
   "check": {
    "ui": "wallet-action-withdraw"
   }
  },
  {
   "check": {
    "ui": "wallet-guidance-add-card"
   }
  },
  {
   "check": {
    "ui": "wallet-guidance-link-bank"
   }
  },
  {
   "check": {
    "screenshot": "wallet"
   }
  },
  {
   "call": "deep_link",
   "uri": "boltbetz-staging://e2e-session/route/MainFlow/Tabs/Home"
  },
  {
   "sleep_ms": 800
  },
  {
   "tap_id": "tab-home",
   "optional": true,
   "wait_s": 2
  },
  {
   "wait_id": "home-screen",
   "wait_s": 15
  }
 ],
 "checks": [
  {
   "ui": "home-screen"
  },
  {
   "no_crash": "com.boltbetz.staging"
  },
  {
   "logs_lack": "FATAL EXCEPTION|ReactNativeJS.*(Unhandled|TypeError|Invariant Violation)",
   "filter": "com.boltbetz.staging"
  }
 ],
 "cleanup": [
  {
   "call": "deep_link",
   "uri": "boltbetz-staging://e2e-session/fault?clear=1"
  },
  {
   "call": "deep_link",
   "uri": "boltbetz-staging://e2e-session/route/MainFlow/Tabs/Home"
  }
 ],
 "note": "Wallet tab: balance hero (shows 'Balance unavailable' with no venue card), Deposit/Withdraw, card + bank setup entries"
}
