{
 "id": "L2-03-withdraw-renders",
 "lane": "L2",
 "timeout_s": 90,
 "preconditions": {
  "signed_in": true,
  "kyc": true,
  "venue_card": false
 },
 "steps": [
  {
   "call": "deep_link",
   "uri": "boltbetz-staging://e2e-session/hooks?on=1"
  },
  {
   "sleep_ms": 800
  },
  {
   "call": "deep_link",
   "uri": "boltbetz-staging://e2e-session/route/MainFlow/Tabs/Home"
  },
  {
   "sleep_ms": 800
  },
  {
   "tap_id": "tab-home",
   "optional": true,
   "wait_s": 2
  },
  {
   "wait_id": "home-screen",
   "wait_s": 15
  },
  {
   "call": "deep_link",
   "uri": "boltbetz-staging://e2e-session/route/MainFlow/Tabs/Wallet/WalletWithdrawal"
  },
  {
   "wait_id": [
    "withdraw-no-card",
    "wallet-withdrawal-screen",
    "withdraw-amount-input"
   ]
  },
  {
   "check": {
    "ui_any": [
     "withdraw-no-card",
     "wallet-withdrawal-screen",
     "withdraw-amount-input"
    ]
   }
  },
  {
   "check": {
    "screenshot": "withdraw"
   }
  },
  {
   "call": "deep_link",
   "uri": "boltbetz-staging://e2e-session/route/MainFlow/Tabs/Home"
  },
  {
   "sleep_ms": 800
  },
  {
   "tap_id": "tab-home",
   "optional": true,
   "wait_s": 2
  },
  {
   "wait_id": "home-screen",
   "wait_s": 15
  }
 ],
 "checks": [
  {
   "ui": "home-screen"
  },
  {
   "no_crash": "com.boltbetz.staging"
  },
  {
   "logs_lack": "FATAL EXCEPTION|ReactNativeJS.*(Unhandled|TypeError|Invariant Violation)",
   "filter": "com.boltbetz.staging"
  }
 ],
 "cleanup": [
  {
   "call": "deep_link",
   "uri": "boltbetz-staging://e2e-session/fault?clear=1"
  },
  {
   "call": "deep_link",
   "uri": "boltbetz-staging://e2e-session/route/MainFlow/Tabs/Home"
  }
 ],
 "note": "Withdraw screen renders; with no venue card it shows the 'Add a player card first' gate. Never submits."
}
