{
 "id": "L1-99-sign-out-send-code",
 "lane": "L1",
 "last": true,
 "timeout_s": 150,
 "preconditions": {
  "signed_in": true
 },
 "steps": [
  {
   "call": "deep_link",
   "uri": "boltbetz-staging://e2e-session/hooks?on=1"
  },
  {
   "sleep_ms": 800
  },
  {
   "call": "deep_link",
   "uri": "boltbetz-staging://e2e-session/route/MainFlow/Tabs/Home"
  },
  {
   "sleep_ms": 800
  },
  {
   "tap_id": "tab-home",
   "optional": true,
   "wait_s": 2
  },
  {
   "wait_id": "home-screen",
   "wait_s": 15
  },
  {
   "call": "deep_link",
   "uri": "boltbetz-staging://e2e-session/route/MainFlow/Tabs/Settings"
  },
  {
   "sleep_ms": 800
  },
  {
   "wait_id": "settings-screen",
   "wait_s": 15
  },
  {
   "call": "swipe",
   "x1": 660,
   "y1": 2300,
   "x2": 660,
   "y2": 700,
   "device_px": true,
   "screenshot": false
  },
  {
   "sleep_ms": 600
  },
  {
   "tap_id": "settings-logout"
  },
  {
   "wait_id": "logout-confirm"
  },
  {
   "tap_id": "logout-confirm"
  },
  {
   "wait_id": [
    "start-login",
    "login-screen"
   ],
   "wait_s": 30
  },
  {
   "check": {
    "screenshot": "signed-out"
   }
  },
  {
   "tap_id": "start-login",
   "optional": true,
   "wait_s": 3
  },
  {
   "wait_id": "login-screen"
  },
  {
   "tap_id": "login-email-toggle",
   "optional": true,
   "wait_s": 2
  },
  {
   "tap_id": "login-identifier-input"
  },
  {
   "call": "shell",
   "cmd": "input keyevent KEYCODE_MOVE_END 67 67 67 67 67 67 67 67 67 67 67 67 67 67 67 67 67 67 67 67 67 67 67 67 67 67 67 67 67 67 67 67 67 67 67 67 67 67 67 67 67 67 67 67 67 67 67 67 67 67 67 67 67 67 67 67 67 67 67 67 "
  },
  {
   "call": "type_text",
   "text": "{lane.email}",
   "screenshot": false
  },
  {
   "sleep_ms": 800
  },
  {
   "tap_id": "login-send-code"
  },
  {
   "wait_id": "code-input",
   "wait_s": 30
  },
  {
   "check": {
    "screenshot": "enter-code"
   }
  }
 ],
 "checks": [
  {
   "ui_any": [
    "home-screen",
    "settings-screen",
    "wallet-main-screen",
    "login-screen",
    "code-input"
   ]
  },
  {
   "no_crash": "com.boltbetz.staging"
  },
  {
   "logs_lack": "FATAL EXCEPTION|ReactNativeJS.*(Unhandled|TypeError|Invariant Violation)",
   "filter": "com.boltbetz.staging"
  }
 ],
 "cleanup": [
  {
   "call": "deep_link",
   "uri": "boltbetz-staging://e2e-session/fault?clear=1"
  },
  {
   "call": "deep_link",
   "uri": "boltbetz-staging://e2e-session/route/MainFlow/Tabs/Home"
  }
 ],
 "note": "P0. Log Out from Settings lands on Start; Log in by email sends a code and shows EnterCode. Last L1 case on purpose: the agent then reads the code from Gmail and types it (signin.py code d0 <code>) to finish sign-in and checks Home."
}
