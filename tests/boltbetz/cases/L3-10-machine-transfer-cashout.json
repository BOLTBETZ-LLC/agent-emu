{
 "id": "L3-10-machine-transfer-cashout",
 "lane": "L3",
 "portable": true,
 "timeout_s": 240,
 "preconditions": {
  "signed_in": true,
  "kyc": true,
  "venue_card": true,
  "emulator_player": "{lane.player}",
  "emulator_machine": "{lane.machine}"
 },
 "steps": [
  {
   "tap_id": "voucher-modal-close-button",
   "optional": true
  },
  {
   "tap_id": "tip-close-button",
   "optional": true
  },
  {
   "tap_id": "machine-tips-sheet-close-button",
   "optional": true
  },
  {
   "sleep_ms": 800
  },
  {
   "emu": "end_session",
   "asset": "{lane.machine}",
   "optional": true
  },
  {
   "emu": "set_cwa",
   "player": "{lane.player}",
   "dollars": 25
  },
  {
   "call": "deep_link",
   "uri": "boltbetz-staging://e2e-session/hooks?on=1"
  },
  {
   "sleep_ms": 800
  },
  {
   "call": "deep_link",
   "uri": "boltbetz-staging://e2e-session/route/MainFlow/Tabs/Home"
  },
  {
   "sleep_ms": 800
  },
  {
   "tap_id": "tab-home",
   "optional": true,
   "wait_s": 2
  },
  {
   "wait_id": "home-screen",
   "wait_s": 15
  },
  {
   "tap_id": "tab-boltbetz"
  },
  {
   "wait_id": [
    "qa-machine-scan-input"
   ],
   "wait_s": 12
  },
  {
   "tap_id": "qa-machine-scan-input"
  },
  {
   "emu": "type_qr",
   "asset": "{lane.machine}"
  },
  {
   "tap_id": "qa-machine-scan-submit"
  },
  {
   "wait_id": "machine-connected-screen",
   "wait_s": 25
  },
  {
   "check": {
    "value": {
     "emu": "/admin/api/players/{lane.player}",
     "field": "cwaAvailable",
     "scale": 100000
    },
    "save": "cwa0"
   }
  },
  {
   "check": {
    "value": {
     "emu": "/machine/{lane.machine}/feed",
     "field": "meterMillicents",
     "scale": 100000
    },
    "expect": "0"
   }
  },
  {
   "check": {
    "value": {
     "ui": "machine-play-option-value-cwa"
    },
    "expect": "cwa0",
    "wait_s": 15
   }
  },
  {
   "tap_id": "machine-play-option-info-button-cwa"
  },
  {
   "wait_id": "machine-transfer-sheet"
  },
  {
   "fill": "machine-transfer-amount",
   "text": "5"
  },
  {
   "tap_id": "machine-transfer-title"
  },
  {
   "tap_id": "machine-transfer-submit"
  },
  {
   "emu": "pin",
   "player": "{lane.player}"
  },
  {
   "sleep_ms": 2000
  },
  {
   "check": {
    "value": {
     "emu": "/machine/{lane.machine}/feed",
     "field": "meterMillicents",
     "scale": 100000
    },
    "expect": "5",
    "wait_s": 25
   }
  },
  {
   "check": {
    "value": {
     "emu": "/admin/api/players/{lane.player}",
     "field": "cwaAvailable",
     "scale": 100000
    },
    "expect": "cwa0 - 5",
    "wait_s": 15
   }
  },
  {
   "check": {
    "value": {
     "ui": "machine-play-option-value-cwa"
    },
    "expect": "cwa0 - 5",
    "wait_s": 15
   }
  },
  {
   "check": {
    "screenshot": "on-machine"
   }
  },
  {
   "tap_id": "machine-session-disconnect-button",
   "wait_s": 8
  },
  {
   "tap_id": "machine-session-disconnect-confirm-button",
   "wait_s": 8
  },
  {
   "wait_id": "machine-tips-sheet",
   "wait_s": 20
  },
  {
   "check": {
    "value": {
     "emu": "/machine/{lane.machine}/feed",
     "field": "meterMillicents",
     "scale": 100000
    },
    "expect": "0",
    "wait_s": 20
   }
  },
  {
   "check": {
    "value": {
     "emu": "/admin/api/players/{lane.player}",
     "field": "cwaAvailable",
     "scale": 100000
    },
    "expect": "cwa0",
    "wait_s": 20
   }
  },
  {
   "check": {
    "ui_text": "machine-tips-balance-text",
    "contains": "$25.00",
    "wait_s": 15
   }
  },
  {
   "check": {
    "screenshot": "cashed-out"
   }
  },
  {
   "tap_id": "machine-tips-sheet-close-button",
   "wait_s": 8
  },
  {
   "sleep_ms": 1500
  },
  {
   "check": {
    "ui": "machine-tips-sheet",
    "present": false
   }
  },
  {
   "call": "deep_link",
   "uri": "boltbetz-staging://e2e-session/hooks?on=1"
  },
  {
   "sleep_ms": 800
  },
  {
   "call": "deep_link",
   "uri": "boltbetz-staging://e2e-session/route/MainFlow/Tabs/Home"
  },
  {
   "sleep_ms": 800
  },
  {
   "tap_id": "tab-home",
   "optional": true,
   "wait_s": 2
  },
  {
   "wait_id": "home-screen",
   "wait_s": 15
  }
 ],
 "checks": [
  {
   "ui_any": [
    "home-screen",
    "settings-screen",
    "wallet-main-screen",
    "login-screen",
    "code-input"
   ]
  },
  {
   "no_crash": "com.boltbetz.staging"
  },
  {
   "logs_lack": "FATAL EXCEPTION|ReactNativeJS.*(Unhandled|TypeError|Invariant Violation)",
   "filter": "com.boltbetz.staging"
  }
 ],
 "cleanup": [
  {
   "tap_id": "voucher-modal-close-button",
   "optional": true
  },
  {
   "tap_id": "tip-close-button",
   "optional": true
  },
  {
   "tap_id": "machine-tips-sheet-close-button",
   "optional": true
  },
  {
   "sleep_ms": 800
  },
  {
   "emu": "end_session",
   "asset": "{lane.machine}",
   "optional": true
  },
  {
   "emu": "set_cwa",
   "player": "{lane.player}",
   "dollars": 25
  },
  {
   "call": "deep_link",
   "uri": "boltbetz-staging://e2e-session/fault?clear=1"
  },
  {
   "call": "deep_link",
   "uri": "boltbetz-staging://e2e-session/route/MainFlow/Tabs/Home"
  }
 ],
 "note": "P0. Connect EMU-L3 by QA paste box, Fund Machine $5 from Wallet Balance (PIN): emulator meter $5 and CWA -$5, app shows $20. Disconnect cashes out: meter $0, CWA back to $25 on the emulator and on the tip sheet."
}
