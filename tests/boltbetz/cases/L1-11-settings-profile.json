{
 "id": "L1-11-settings-profile",
 "lane": "L1",
 "timeout_s": 90,
 "preconditions": {
  "signed_in": true,
  "kyc": true,
  "venue_card": false
 },
 "steps": [
  {
   "call": "deep_link",
   "uri": "boltbetz-staging://e2e-session/hooks?on=1"
  },
  {
   "sleep_ms": 800
  },
  {
   "call": "deep_link",
   "uri": "boltbetz-staging://e2e-session/route/MainFlow/Tabs/Home"
  },
  {
   "sleep_ms": 800
  },
  {
   "tap_id": "tab-home",
   "optional": true,
   "wait_s": 2
  },
  {
   "wait_id": "home-screen",
   "wait_s": 15
  },
  {
   "call": "deep_link",
   "uri": "boltbetz-staging://e2e-session/route/MainFlow/Tabs/Settings"
  },
  {
   "wait_id": "settings-screen"
  },
  {
   "check": {
    "ui": "settings-name-value"
   }
  },
  {
   "check": {
    "ui": "settings-address-value"
   }
  },
  {
   "check": {
    "ui": "settings-phone-value"
   }
  },
  {
   "check": {
    "ui": "settings-email-value"
   }
  },
  {
   "check": {
    "ui": "settings-retry-profile",
    "present": false
   }
  },
  {
   "check": {
    "screenshot": "profile"
   }
  },
  {
   "call": "deep_link",
   "uri": "boltbetz-staging://e2e-session/route/MainFlow/Tabs/Home"
  },
  {
   "sleep_ms": 800
  },
  {
   "tap_id": "tab-home",
   "optional": true,
   "wait_s": 2
  },
  {
   "wait_id": "home-screen",
   "wait_s": 15
  }
 ],
 "checks": [
  {
   "ui": "home-screen"
  },
  {
   "no_crash": "com.boltbetz.staging"
  },
  {
   "logs_lack": "FATAL EXCEPTION|ReactNativeJS.*(Unhandled|TypeError|Invariant Violation)",
   "filter": "com.boltbetz.staging"
  }
 ],
 "cleanup": [
  {
   "call": "deep_link",
   "uri": "boltbetz-staging://e2e-session/fault?clear=1"
  },
  {
   "call": "deep_link",
   "uri": "boltbetz-staging://e2e-session/route/MainFlow/Tabs/Home"
  }
 ],
 "note": "Settings > Account Information shows name, address, phone, email; no retry row."
}
