{
 "id": "L1-13-notifications",
 "lane": "L1",
 "portable": true,
 "timeout_s": 90,
 "preconditions": {
  "signed_in": true,
  "kyc": true,
  "venue_card": false
 },
 "steps": [
  {
   "call": "deep_link",
   "uri": "boltbetz-staging://e2e-session/hooks?on=1"
  },
  {
   "sleep_ms": 800
  },
  {
   "call": "deep_link",
   "uri": "boltbetz-staging://e2e-session/route/MainFlow/Tabs/Home"
  },
  {
   "sleep_ms": 800
  },
  {
   "tap_id": "tab-home",
   "optional": true,
   "wait_s": 2
  },
  {
   "wait_id": "home-screen",
   "wait_s": 15
  },
  {
   "call": "deep_link",
   "uri": "boltbetz-staging://e2e-session/route/MainFlow/Notifications"
  },
  {
   "wait_id": "notifications-screen"
  },
  {
   "check": {
    "ui_any": [
     "notifications-empty",
     "notifications-list-item-0"
    ]
   }
  },
  {
   "check": {
    "ui": "notifications-list"
   }
  },
  {
   "check": {
    "screenshot": "notifications"
   }
  },
  {
   "call": "deep_link",
   "uri": "boltbetz-staging://e2e-session/route/MainFlow/Tabs/Home"
  },
  {
   "sleep_ms": 800
  },
  {
   "tap_id": "tab-home",
   "optional": true,
   "wait_s": 2
  },
  {
   "wait_id": "home-screen",
   "wait_s": 15
  }
 ],
 "checks": [
  {
   "ui": "home-screen"
  },
  {
   "no_crash": "com.boltbetz.staging"
  },
  {
   "logs_lack": "FATAL EXCEPTION|ReactNativeJS.*(Unhandled|TypeError|Invariant Violation)",
   "filter": "com.boltbetz.staging"
  }
 ],
 "cleanup": [
  {
   "call": "deep_link",
   "uri": "boltbetz-staging://e2e-session/fault?clear=1"
  },
  {
   "call": "deep_link",
   "uri": "boltbetz-staging://e2e-session/route/MainFlow/Tabs/Home"
  }
 ],
 "note": "Notification list renders (route jump: the no-card Home has no bell). Empty state on a fresh account."
}
