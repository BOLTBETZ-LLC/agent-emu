{
 "id": "M-deposit-010-submit-belowmin",
 "lane": "L2",
 "timeout_s": 120,
 "preconditions": {
  "signed_in": true,
  "kyc": true,
  "venue_card": true,
  "saved_card": true
 },
 "matrix": {
