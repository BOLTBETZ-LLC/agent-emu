   "optional": true
  },
  {
   "emu": "end_session",
   "asset": "{lane.machine}",
   "optional": true
  },
  {
   "emu": "set_cwa",
   "player": "{lane.player}",
   "dollars": 25
  },
  {
   "call": "deep_link",
   "uri": "boltbetz-staging://e2e-session/route/MainFlow/Tabs/Home"
  }
 ],
