{
 "id": "M-link-014-openoperator-op1-bgresume",
 "lane": "any",
 "timeout_s": 120,
 "preconditions": {
  "signed_in": true,
  "kyc": true,
  "venue_card": true
 },
 "matrix": {
  "area": "link",
  "row": {
   "Step": "open_operator",
   "Operator": "op1",
   "AppFault": "none",
   "Lifecycle": "bg_resume"
  },
  "expect": "success",
  "est_s": 20
 },
 "steps": [
  {
   "call": "deep_link",
   "uri": "boltbetz-staging://e2e-session/hooks?on=1"
  },
  {
   "call": "deep_link",
   "uri": "boltbetz-staging://e2e-session/route/MainFlow/Tabs/Home"
  },
  {
   "tap_id": "tab-home",
   "optional": true,
   "wait_s": 2
  },
  {
   "wait_id": "home-screen",
   "wait_s": 20
  },
  {
   "call": "deep_link",
   "uri": "boltbetz-staging://e2e-session/route/MainFlow/LinkAccount"
  },
  {
   "wait_id": "link-account-screen",
   "wait_s": 15
  },
  {
   "call": "key",
   "name": "home",
   "screenshot": false
  },
  {
   "sleep_ms": 1500
  },
  {
   "call": "app",
   "launch": "com.boltbetz.staging"
  },
  {
   "sleep_ms": 800
  },
  {
   "call": "deep_link",
   "uri": "boltbetz-staging://e2e-session/route/MainFlow/LinkAccount"
  },
  {
   "wait_id": "link-account-screen",
   "wait_s": 15
  },
  {
   "tap_id": "link-account-operator-1"
  },
  {
   "sleep_ms": 2500
  },
  {
   "check": {
    "screenshot": "operator"
   }
  },
  {
   "check": {
    "judge": "The screen offers to link an existing player card or to create a new player account at this venue",
    "settle_s": 2
   }
  },
  {
   "tap_id": "link-account-close",
   "optional": true
  }
 ],
 "checks": [
  {
   "no_crash": "com.boltbetz.staging"
  },
  {
   "logs_lack": "FATAL EXCEPTION|ReactNativeJS.*(Unhandled|TypeError|Invariant Violation)",
   "filter": "com.boltbetz.staging"
  },
  {
   "ui": "fatal-error-screen",
   "present": false,
   "wait_s": 1
  }
 ],
 "cleanup": [
  {
   "tap_id": "enter-pin-close-button",
   "optional": true
  },
  {
   "tap_id": "wallet-modal-close",
   "optional": true
  },
  {
   "tap_id": "voucher-modal-close-button",
   "optional": true
  },
  {
   "tap_id": "tip-close-button",
   "optional": true
  },
  {
   "tap_id": "machine-tips-sheet-close-button",
   "optional": true
  },
  {
   "call": "deep_link",
   "uri": "boltbetz-staging://e2e-session/fault?clear=1"
  },
  {
   "emu": "req",
   "method": "POST",
   "path": "/admin/api/cards/{lane.card}/lock",
   "body": {
    "locked": false
   },
   "optional": true
  },
  {
   "emu": "req",
   "method": "PUT",
   "path": "/admin/api/players/{lane.player}",
   "body": {
    "cwaEnabled": true
   },
   "optional": true
  },
  {
   "emu": "end_session",
   "asset": "{lane.machine}",
   "optional": true
  },
  {
   "emu": "set_cwa",
   "player": "{lane.player}",
   "dollars": 25
  },
  {
   "call": "deep_link",
   "uri": "boltbetz-staging://e2e-session/route/MainFlow/Tabs/Home"
  }
 ],
 "note": "PICT row 14 of matrix/models/link.pict: Step=open_operator, Operator=op1, AppFault=none, Lifecycle=bg_resume"
}
