{
 "id": "M-tips-044-wallettip-small-22012-killmid",
 "lane": "any",
 "timeout_s": 180,
 "preconditions": {
  "signed_in": true,
  "kyc": true,
  "venue_card": true
 },
 "matrix": {
  "area": "tips",
  "row": {
   "Entry": "wallet_tip",
   "Amount": "small",
   "State": "funded",
   "FaultEndpoint": "none",
   "AppFault": "none",
   "SynkrosErr": "22-012",
   "Lifecycle": "kill_mid"
  },
  "expect": "error",
  "est_s": 45
 },
 "steps": [
  {
   "call": "deep_link",
   "uri": "boltbetz-staging://e2e-session/hooks?on=1"
  },
  {
   "call": "deep_link",
   "uri": "boltbetz-staging://e2e-session/route/MainFlow/Tabs/Home"
  },
  {
   "tap_id": "tab-home",
   "optional": true,
   "wait_s": 2
  },
  {
   "wait_id": "home-screen",
   "wait_s": 20
  },
  {
   "check": {
    "value": {
     "emu": "/admin/api/players/{lane.player}",
     "field": "cwaAvailable",
     "scale": 100000
    },
    "save": "cwa0"
   }
  },
  {
   "tap_id": "home-action-tip"
  },
  {
   "wait_id": "tip-title",
   "wait_s": 15
  },
  {
   "fill": "tip-amount-input",
   "text": "3"
  },
  {
   "tap_id": "tip-title"
  },
  {
   "emu": "req",
   "method": "POST",
   "path": "/admin/api/errors",
   "body": {
    "operation": "cashout-vouchers",
    "errorCode": "22-012",
    "times": 1,
    "playerId": "{lane.player}"
   }
  },
  {
   "tap_id": "tip-submit-button"
  },
  {
   "emu": "pin",
   "player": "{lane.player}"
  },
  {
   "call": "shell",
   "cmd": "am force-stop com.boltbetz.staging"
  },
  {
   "call": "app",
   "launch": "com.boltbetz.staging"
  },
  {
   "wait_id": [
    "home-screen",
    "tab-home"
   ],
   "wait_s": 40
  },
  {
   "call": "deep_link",
   "uri": "boltbetz-staging://e2e-session/hooks?on=1"
  },
  {
   "sleep_ms": 8000
  },
  {
   "check": {
    "value": {
     "emu": "/admin/api/players/{lane.player}",
     "field": "cwaAvailable",
     "scale": 100000
    },
    "save": "cwa1"
   }
  },
  {
   "call": "deep_link",
   "uri": "boltbetz-staging://e2e-session/route/MainFlow/Tabs/Wallet/WalletMain"
  },
  {
   "wait_id": "wallet-main-screen",
   "wait_s": 20
  },
  {
   "call": "swipe",
   "x1": 660,
   "y1": 600,
   "x2": 660,
   "y2": 1900,
   "device_px": true,
   "screenshot": false
  },
  {
   "sleep_ms": 2500
  },
  {
   "check": {
    "value": {
     "ui": "wallet-balance-amount"
    },
    "expect": "cwa1",
    "wait_s": 30
   }
  }
 ],
 "checks": [
  {
   "no_crash": "com.boltbetz.staging"
  },
  {
   "logs_lack": "FATAL EXCEPTION|ReactNativeJS.*(Unhandled|TypeError|Invariant Violation)",
   "filter": "com.boltbetz.staging"
  },
  {
   "ui": "fatal-error-screen",
   "present": false,
   "wait_s": 1
  }
 ],
 "cleanup": [
  {
   "tap_id": "enter-pin-close-button",
   "optional": true
  },
  {
   "tap_id": "wallet-modal-close",
   "optional": true
  },
  {
   "tap_id": "voucher-modal-close-button",
   "optional": true
  },
  {
   "tap_id": "tip-close-button",
   "optional": true
  },
  {
   "tap_id": "machine-tips-sheet-close-button",
   "optional": true
  },
  {
   "call": "deep_link",
   "uri": "boltbetz-staging://e2e-session/fault?clear=1"
  },
  {
   "emu": "req",
   "method": "POST",
   "path": "/admin/api/cards/{lane.card}/lock",
   "body": {
    "locked": false
   },
   "optional": true
  },
  {
   "emu": "req",
   "method": "PUT",
   "path": "/admin/api/players/{lane.player}",
   "body": {
    "cwaEnabled": true
   },
   "optional": true
  },
  {
   "emu": "end_session",
   "asset": "{lane.machine}",
   "optional": true
  },
  {
   "emu": "set_cwa",
   "player": "{lane.player}",
   "dollars": 25
  },
  {
   "call": "deep_link",
   "uri": "boltbetz-staging://e2e-session/route/MainFlow/Tabs/Home"
  }
 ],
 "note": "PICT row 44 of matrix/models/tips.pict: Entry=wallet_tip, Amount=small, State=funded, FaultEndpoint=none, AppFault=none, SynkrosErr=22-012, Lifecycle=kill_mid"
}
