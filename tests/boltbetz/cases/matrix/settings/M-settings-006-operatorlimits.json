  {
   "wait_id": "operator-limits-screen",
   "wait_s": 15
  },
  {
   "check": {
    "ui": "operator-limits-dep_card-value",
    "wait_s": 15
   }
  },
  {
   "check": {
    "screenshot": "operator_limits"
   }
  }
 ],
 "checks": [
  {
   "no_crash": "com.boltbetz.staging"
  },
  {
