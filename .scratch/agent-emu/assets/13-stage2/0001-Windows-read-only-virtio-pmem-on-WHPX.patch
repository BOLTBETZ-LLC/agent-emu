+// agent-emu: Windows pmem is read-only only (Pmem::new refuses writable), so DISCARD is never
+// offered and pageout never runs. A read-only file view has no dirty pages, so FLUSH has nothing
+// to write back and is answered here without a main-process round trip.
+#[cfg(windows)]
+fn execute_request(
+    request_type: u32,
+    _start_address: u64,
+    _size: u64,
+    _pmem_device_tube: &Tube,
+    _mapping_arena_slot: u32,
+    _mapping_size: usize,
+) -> u32 {
+    match request_type {
+        VIRTIO_PMEM_REQ_TYPE_FLUSH => VIRTIO_PMEM_RESP_TYPE_OK,
+        _ => {
+            error!(
+                "pmem: unsupported request type on Windows: {}",
+                request_type
+            );
+            VIRTIO_PMEM_RESP_TYPE_EIO
+        }
+    }
+}
