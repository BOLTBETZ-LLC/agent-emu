+    // agent-emu: a read-only handle must map with Protection::read() (pmem image path).
+    #[test]
+    fn read_only_file_map() {
+        use std::io::Write;
+        let mut f = tempfile::NamedTempFile::new().unwrap();
+        f.write_all(&[7u8; 4096]).unwrap();
+        let ro = std::fs::File::open(f.path()).unwrap();
+        let m = crate::MemoryMappingBuilder::new(4096)
+            .from_file(&ro)
+            .protection(Protection::read())
+            .build()
+            .unwrap();
+        assert_eq!(m.read_obj::<u8>(4095).unwrap(), 7);
+    }
