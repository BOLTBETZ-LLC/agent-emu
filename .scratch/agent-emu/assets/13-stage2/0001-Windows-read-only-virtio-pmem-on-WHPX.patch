+// agent-emu: virtio-pmem for a read-only image file, created in the main process (no
+// vhost-user backend). The file is mapped as one PAGE_READONLY view and handed to WHPX with
+// WHvMapGpaRange read|execute, so guest DAX reads hit the file's page-cache pages directly.
+fn create_pmem_device(
+    cfg: &Config,
+    vm: &dyn VmArch,
+    resources: &mut SystemAllocator,
+    pmem: &crate::crosvm::config::PmemOption,
+    index: usize,
+) -> DeviceResult {
+    if !pmem.ro || pmem.vma_size.is_some() || pmem.swap_interval.is_some() {
+        bail!("--pmem on Windows needs ro=true and no vma-size/swap-interval");
+    }
+    let disk_image = open_file_or_duplicate(&pmem.path, OpenOptions::new().read(true))
+        .with_context(|| format!("failed to open pmem image {}", pmem.path.display()))?;
+    let disk_size = disk_image
+        .metadata()
+        .with_context(|| format!("failed to stat pmem image {}", pmem.path.display()))?
+        .len();
+    // Linux needs the pmem region 2 MiB aligned. Linux crosvm pads with an anonymous arena tail;
+    // a read-only Windows section cannot extend past EOF, so require a pre-padded image instead.
+    const PMEM_ALIGN: u64 = 2 * 1024 * 1024;
+    if disk_size == 0 || disk_size % PMEM_ALIGN != 0 {
+        bail!(
+            "pmem image {} is {} bytes; it must be a non-zero multiple of 2 MiB (pad the file)",
+            pmem.path.display(),
+            disk_size
+        );
+    }
+    let mapping =
+        base::MemoryMappingBuilder::new(usize::try_from(disk_size).context("pmem image too big")?)
+            .from_file(&disk_image)
+            .protection(base::Protection::read())
+            .build()
+            .context("failed to map pmem image")?;
+
+    let mapping_address = vm_memory::GuestAddress(
+        resources
+            .allocate_mmio(
+                disk_size,
+                resources::Alloc::PmemDevice(index),
+                format!("pmem_disk_image_{index}"),
+                resources::AllocOptions::new()
+                    .top_down(false)
+                    .prefetchable(true)
+                    // Linux requires pmem namespaces to be 128 MiB aligned.
+                    .align(128 * 1024 * 1024),
+            )
+            .context("failed to allocate guest address space for pmem")?,
+    );
+    let slot = vm
+        .add_memory_region(
+            mapping_address,
+            Box::new(mapping),
+            /* read_only= */ true,
+            /* log_dirty_pages= */ false,
+            hypervisor::MemCacheType::CacheCoherent,
+        )
+        .context("failed to map pmem image into the guest")?;
+
+    // The worker answers requests locally on Windows (see devices pmem.rs); this tube has no
+    // main-process listener.
+    let (pmem_device_tube, _unused_host_tube) =
+        Tube::pair().exit_context(Exit::CreateTube, "failed to create tube")?;
+    let dev = virtio::Pmem::new(
+        virtio::base_features(cfg.protection_type),
+        virtio::PmemConfig {
+            disk_image: Some(disk_image),
+            mapping_address,
+            mem_slot: virtio::MemSlotConfig::MemSlot { idx: slot },
+            mapping_size: disk_size,
+            pmem_device_tube,
+            swap_interval: None,
+            mapping_writable: false,
+        },
+    )
+    .context("failed to create pmem device")?;
+
+    Ok(VirtioDeviceStub {
+        dev: Box::new(dev),
+        jail: None,
+    })
+}
+
